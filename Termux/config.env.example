# ~/.config/nro-termux/config.env
# A shell config file loaded by nroctl. Keep permissions 600.
# Do not put public server passwords or third-party production credentials here.
NRO_ROOT="$HOME/nro-local"
NRO_SERVER_DIR="$NRO_ROOT/server"
NRO_JAR="$NRO_SERVER_DIR/Server.jar"
NRO_HEAP_MB=384
NRO_GAME_PORT=14445
# Original historical server also has a separate API port. 0 disables its check.
NRO_API_PORT=8181
# When Server.jar lacks a manifest Main-Class, set this only after checking its real entry point:
NRO_MAIN_CLASS=""
# Defaults to manual DB start. Change to 1 if MariaDB is already initialized and secured.
NRO_AUTOSTART_DB=0
NRO_DB_NAME=nro_local
NRO_DB_PORT=3306
# Avoid editing other accounts' MySQL installation:
# NRO_DB_DATADIR="$PREFIX/var/lib/mysql"
# NRO_DB_SOCKET="$PREFIX/var/run/mysqld.sock"
