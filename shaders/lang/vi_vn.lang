screen.Misc_Settings.comment = Các cài đặt ngẫu nhiên dùng để GỠ LỖI hoặc nghịch cho vui.
screen.Sun_and_Moon_Colors.comment = Chỉnh màu của Mặt Trời và Mặt Trăng.
option.sunPathRotation.comment = Chỉnh góc quỹ đạo của Mặt Trời và Mặt Trăng.
option.sun_illuminance.comment = Chỉnh độ sáng của Mặt Trời.
option.moon_illuminance.comment = Chỉnh độ sáng của Mặt Trăng.

screen.Direct_Light.comment = Các cài đặt liên quan đến Mặt Trời và bóng đổ.

screen.Shadows.comment = Tùy chỉnh bóng đổ do Mặt Trời tạo ra theo ý bạn.
    option.SCREENSPACE_CONTACT_SHADOWS.comment = §bĐây là gì?§r Bóng đổ cho vật ở xa và cho các chi tiết nhỏ ở gần. §aCHI PHÍ HIỆU NĂNG:§r thấp đến trung bình; tốn hơn ở độ phân giải cao.
    option.RENDER_ENTITY_SHADOWS.comment = §bĐây là gì?§r Bóng đổ cho mọi loại thực thể như sinh vật, rương, biểu ngữ hay biển báo. §aCHI PHÍ HIỆU NĂNG:§r thấp đến cao; rất tốn khi có nhiều thực thể ở gần.
    option.shadowMapResolution.comment = Chất lượng bóng do Mặt Trời tạo ra từ các vật trong thế giới. §aCHI PHÍ HIỆU NĂNG:§r trung bình đến rất cao; shader phải vẽ thế giới 3D lần thứ hai từ góc nhìn của Mặt Trời, vì vậy hiệu năng có thể giảm một nửa.
    option.shadowDistance.comment = Khoảng cách tối đa mà shadowmap có thể vẽ. Khi đặt là không tối ưu, khoảng cách không được đo tuyến tính theo chunk. §aCHI PHÍ HIỆU NĂNG:§r trung bình đến rất cao; nếu tầm nhìn chunk cao thì bóng đổ càng tốn.
    option.OPTIMIZED_SHADOW_DISTANCE.comment = Chỉ vẽ bóng trong một hình cầu quanh bạn, giới hạn bởi khoảng cách tối đa tính theo chunk. Chế độ không tối ưu không vẽ theo hình cầu và không bị khóa theo chunk; với cùng khoảng cách nó phủ được vùng rộng hơn nhiều. Ở chế độ không tối ưu, khoảng cách không đo bằng chunk. §aCHI PHÍ HIỆU NĂNG:§r thấp đến trung bình. Tối ưu thì nhanh hơn, không tối ưu thì chậm hơn.
    screen.Filtering.comment = Chỉnh các hiệu ứng lọc áp dụng lên bóng đổ.
        option.SHADOW_FILTER_SAMPLE_COUNT.comment = Chất lượng của bộ lọc bóng cơ bản. Bộ lọc này chỉ làm mềm bóng. §aCHI PHÍ HIỆU NĂNG:§r thấp đến trung bình; tăng giá trị này sẽ giảm bớt nhiễu ở mép bóng.
        option.Min_Shadow_Filter_Radius.comment = Độ mềm tối đa của bộ lọc bóng cơ bản.
        option.Variable_Penumbra_Shadows.comment = Hiệu ứng này làm bóng càng mềm khi càng xa vật tạo ra nó. Dùng để tạo bóng chất lượng cao hơn và tán xạ dưới bề mặt. §aCHI PHÍ HIỆU NĂNG:§r thấp đến cao;
        option.VPS_Search_Samples.comment = Chất lượng của bộ lọc bóng bán dạ biến thiên. §aCHI PHÍ HIỆU NĂNG:§r thấp đến cao; tăng giá trị này sẽ giảm nhiễu trong tán xạ dưới bề mặt và các bóng rất mềm.
        option.Max_Shadow_Filter_Radius.comment = Độ mềm tối đa mà bóng có thể đạt được khi ở xa vật tạo ra nó.
        option.Max_Filter_Depth.comment = Chỉnh kích thước của Mặt Trời. Mặt Trời càng lớn thì bóng càng mềm ngay gần vật tạo ra nó.

screen.Ambient_light.comment = Các cài đặt liên quan đến ánh sáng ở những chỗ có bóng râm.
    option.AO_Strength.comment = Chỉnh cường độ che khuất môi trường (AO) tạo bởi SSAO, GTAO, RTAO và SSGI. §bĐây là gì?§r AO là những bóng mềm nhỏ ở góc tường và các khe hở.
    option.GI_Strength.comment = Chỉnh cường độ chiếu sáng toàn cục (GI) tạo bởi SSGI. §bĐây là gì?§r Trong trường hợp này, GI là ánh sáng phản xạ từ bề mặt này sang khu vực khác.
    option.HQ_SSGI.comment = Bật/tắt chiếu sáng toàn cục không gian màn hình tầm xa. §aCHI PHÍ HIỆU NĂNG:§r rất cao
    option.Hand_Held_lights.comment = Bật/tắt nguồn sáng cầm tay do shader xử lý. §aCHI PHÍ HIỆU NĂNG:§r rất thấp
    option.SKY_CONTRIBUTION_IN_SSRT.comment = Cho phép RTAO hoặc SSGI tính cả bầu trời và sương mù để tạo ánh sáng chất lượng cao cho vùng bóng râm. Có thể gây thêm nhiễu. §aCHI PHÍ HIỆU NĂNG:§r trung bình

    option.ambientOcclusionLevel.comment = Chỉnh cường độ AO của Minecraft gốc. §bĐây là gì?§r AO này có sẵn trong Minecraft ngay cả khi không bật shader.
    option.ambient_brightness.comment = Chỉnh độ sáng của ánh sáng ở những chỗ có bóng râm.
    option.MIN_LIGHT_AMOUNT.comment = Chỉnh lượng ánh sáng tối thiểu có thể có ở những chỗ có bóng râm.
    option.indirect_effect.comment = Chọn các hiệu ứng khác nhau để ánh sáng ở chỗ có bóng râm đẹp hơn. §aCHI PHÍ HIỆU NĂNG:§r AO gốc: rất thấp. SSAO: thấp đến trung bình. GTAO: trung bình đến cao. RTAO hoặc SSGI: cao đến rất cao.

    screen.Ambient_Colors.comment = Chỉnh màu ánh sáng ở những vùng có bóng râm.
    screen.Torch_Colors.comment = Chỉnh màu ánh sáng từ đuốc và các nguồn sáng đặt trong thế giới.

    option.LPV_SIZE.comment = Chỉnh kích thước (tính bằng khối) của vùng thể tích dùng cho ánh sáng màu.
    option.LPV_SATURATION.comment = Chỉnh cường độ của ánh sáng màu.
    option.LPV_TINT_SATURATION.comment = Chỉnh cường độ nhuộm màu của các khối trong suốt lên ánh sáng màu.
    option.LPV_NORMAL_STRENGTH.comment = Chỉnh mức độ pháp tuyến bề mặt ảnh hưởng đến hướng ánh sáng.
    option.LPV_ENTITY_LIGHTS.comment = Cho phép thực thể đóng góp vào ánh sáng màu.
    option.LPV_REDSTONE_LIGHTS.comment = Cho phép các khối redstone đóng góp vào ánh sáng màu.
    option.LPV_COLORED_CANDLES.comment = Cho phép nến có màu phát ra ánh sáng màu tương ứng.
    option.LPV_NOSHADOW_HACK.comment = Bản vá cho Iris 1.7.0 trở xuống! Cho phép FloodFill hoạt động ở Nether và End, nhưng tắt ánh sáng của thực thể và vật phẩm rơi.
    option.LPV_VL_FOG_ILLUMINATION.comment = Cho phép ánh sáng màu chiếu sáng không khí xung quanh nó.
    option.LPV_VL_FOG_ILLUMINATION_BRIGHTNESS.comment = Chỉnh độ sáng của sương mù được chiếu sáng.
    
screen.Resource_Pack_Support.comment = Một số hiệu ứng dùng thông tin do gói tài nguyên cung cấp.
    screen.Reflections.comment = Chỉnh các phản chiếu dùng thông tin từ gói tài nguyên LabPBR.
        option.Specular_Reflections.comment = Bật/tắt mọi phản chiếu cho gói LabPBR. Mục này bật phản chiếu Mặt Trời và cho phép bật các cài đặt bên dưới. §aCHI PHÍ HIỆU NĂNG:§r thấp
        option.Screen_Space_Reflections.comment = Bật/tắt phản chiếu không gian màn hình. §aCHI PHÍ HIỆU NĂNG:§r trung bình
        option.Rough_reflections.comment = Bật/tắt độ nhám chi tiết hơn để phản chiếu đẹp hơn. Sẽ gây khá nhiều nhiễu hình. §aCHI PHÍ HIỆU NĂNG:§r trung bình đến cao
        option.Sky_reflection.comment = Bật/tắt phản chiếu bầu trời và sương mù. §aCHI PHÍ HIỆU NĂNG:§r thấp đến trung bình.
        option.Dynamic_SSR_quality.comment = Giảm chất lượng phản chiếu không gian màn hình tùy theo mức độ nhìn thấy của chúng. Có thể tăng hiệu năng nhưng giảm chất lượng.
        option.Roughness_Threshold.comment = Nếu độ nhám đạt ngưỡng này, mọi phản chiếu (trừ Mặt Trời) sẽ không được vẽ. Có thể tăng hiệu năng.
        option.Sun_specular_Strength.comment = Chỉnh độ sáng của phản chiếu Mặt Trời.
        option.reflection_quality.comment = Chỉnh chất lượng của phản chiếu không gian màn hình.

screen.Subsurface_Scattering.comment = §bĐây là gì?§r Tán xạ dưới bề mặt là hiện tượng khi bạn chiếu đèn sáng vào bàn tay và nó bắt đầu phát sáng. Mặt Trời cũng làm điều tương tự với cây cối, vải, da và nhiều vật khác.
    option.SSS_TYPE.comment = Chọn cách áp dụng tán xạ dưới bề mặt lên thế giới. §bCài sẵn:§r shader quyết định vật nào có hiệu ứng. §bLabSSS:§r gói tài nguyên quyết định vật nào có hiệu ứng. §aCHI PHÍ HIỆU NĂNG:§r rất thấp
    option.MOB_SSS.comment = Bật/tắt tán xạ dưới bề mặt cho sinh vật (bao gồm cả người chơi). §aCHI PHÍ HIỆU NĂNG:§r rất thấp
    option.MISC_BLOCK_SSS.comment = Bật/tắt tán xạ dưới bề mặt cho các khối ngẫu nhiên có thể không phù hợp, chủ yếu là cỏ và cát. §aCHI PHÍ HIỆU NĂNG:§r rất thấp
    option.Ambient_SSS.comment = §bĐây là gì?§r Tán xạ dưới bề mặt từ ánh sáng bầu trời thay vì Mặt Trời. §aCHI PHÍ HIỆU NĂNG:§r rất thấp đến trung bình; nếu bật SSAO thì tốn rất ít, nhưng tốn hơn nếu SSAO TẮT
    option.ambientsss_brightness.comment = Chỉnh độ sáng của tán xạ dưới bề mặt từ ánh sáng bầu trời.

screen.Emissives.comment = §bĐây là gì?§r Phát sáng (emissive) là mức độ một vật tỏa ra ánh sáng hoặc phát sáng.
    option.Emissive_Brightness.comment = Chỉnh độ sáng của hiệu ứng phát sáng trên texture.
    option.EMISSIVE_TYPE.comment = Chọn cách áp dụng hiệu ứng phát sáng của texture lên thế giới. §bCài sẵn:§r shader quyết định vật nào phát sáng. §bLab:§r gói tài nguyên quyết định vật nào phát sáng. §aCHI PHÍ HIỆU NĂNG:§r rất thấp
    option.Emissive_Curve.comment = Quyết định texture phát sáng đạt độ sáng cao nhất nhanh đến mức nào. 1.0 là tuyến tính.

screen.POM.comment = Các cài đặt liên quan đến parallax occlusion mapping, dùng thông tin từ gói tài nguyên.
    option.POM.comment = §bĐây là gì?§r Hiệu ứng này cố tạo hình khối 3D ở nơi trước đó không có, bằng một ảnh đặc biệt từ gói tài nguyên. Hiệu ứng chủ yếu chỉ lõm vào trong nên có thể xuất hiện lỗi hình khi nhìn ở góc xiên. §aCHI PHÍ HIỆU NĂNG:§r trung bình đến cao
    option.MAX_ITERATIONS.comment = Chỉnh chất lượng hiệu ứng parallax occlusion mapping. Nếu bạn thấy từng lớp riêng lẻ khi nhìn gần, tăng giá trị này sẽ tạo thêm lớp nên khó thấy hơn. §aCHI PHÍ HIỆU NĂNG:§r cao
    option.POM_DEPTH.comment = Hiệu ứng có thể lõm sâu bao nhiêu vào bề mặt. §aCHI PHÍ HIỆU NĂNG:§r rất thấp
    option.MAX_DIST.comment = Khoảng cách tối đa từ camera mà hiệu ứng parallax occlusion mapping còn được vẽ. §aCHI PHÍ HIỆU NĂNG:§r cao
    option.Adaptive_Step_length.comment = Tăng chất lượng hình ảnh mà không cần tăng chất lượng thực tế. Có thể gây lỗi hình nếu nhìn rất gần hoặc heightmap quá phức tạp với độ cao thay đổi gắt.
    option.Horrible_slope_normals.comment = Một cách triển khai làm kém để tạo bề mặt ở các cạnh bên của parallax occlusion mapping. Không khuyến khích dùng. §aCHI PHÍ HIỆU NĂNG:§r thấp
    
screen.Porosity.comment = Các cài đặt liên quan đến độ ẩm ướt và vũng nước.
    option.Porosity.comment = §bĐây là gì?§r Độ thấm nước mô tả vật liệu xốp đến mức nào, tức là nó chứa được bao nhiêu nước. Ví dụ bọt biển rất xốp; nước thấm vào bên trong và làm nó sẫm màu hơn. §aCHI PHÍ HIỆU NĂNG:§r thấp
    option.Puddles.comment = Bật/tắt vũng nước khi trời mưa. §aCHI PHÍ HIỆU NĂNG:§r thấp
    option.Puddle_Size.comment = Chỉnh kích thước của các vũng nước.

screen.Fog.comment = Các cài đặt liên quan đến sương mù thể tích (raymarch) hoặc sương mù theo khoảng cách.
    option.VL_RENDER_RESOLUTION.comment = Chỉnh độ phân giải của sương mù thể tích. §aCHI PHÍ HIỆU NĂNG:§r cao
    option.VL_SAMPLES.comment = Chỉnh chất lượng của sương mù thể tích. §aCHI PHÍ HIỆU NĂNG:§r cao
    option.BLOOMY_FOG.comment = Chỉnh cường độ bloom áp dụng lên sương mù. §bĐây là gì?§r Hiệu ứng này làm sương mù trông mềm hơn và che bớt nhiễu một chút. Có thể gây nhấp nháy ở các cạnh chi tiết. §aCHI PHÍ HIỆU NĂNG:§r rất thấp
    option.Haze_amount.comment = Chỉnh độ dày đặc của bầu khí quyển quanh bạn. §bĐây là gì?§r Đây là lớp khói mù xanh bạn thấy ở phía xa.
    option.RainFog_amount.comment = Chỉnh độ dày của sương mù khi trời mưa.
    option.RAYMARCH_CLOUDS_WITH_FOG.comment = §cCẢNH BÁO§r: Cài đặt này còn thử nghiệm và chưa hoàn thiện! Bạn cần tăng số mẫu sương mù để khớp với mây thường. Bật sương mù chi tiết khi bạn ở trong hoặc gần đám mây. §aCHI PHÍ HIỆU NĂNG:§r cao.
    option.BorderFog.comment = §bĐây là gì?§r Bật/tắt lớp sương mù cố che việc chunk đang tải. Nhưng vì bầu trời thay đổi liên tục nên rất khó làm tốt. §aCHI PHÍ HIỆU NĂNG:§r rất rất thấp

    screen.TOD_fog.comment = Chỉnh mật độ sương mù xuất hiện vào những thời điểm cụ thể trong ngày.
        option.TOD_Fog_mult.comment = Chỉnh tổng lượng sương mù xuất hiện vào những thời điểm cụ thể trong ngày. Không ảnh hưởng đến khói mù khí quyển.

    screen.Cave_Fog.comment = Các cài đặt cho sương mù xuất hiện khi bạn ở nơi rất tối như hang động.
        option.Cave_Fog.comment = Bật/tắt sương mù xuất hiện ở nơi tối. Shader không thể biết chính xác bạn có đang ở trong hang hay không nên sương mù này có thể xuất hiện ở nơi không phải hang. §aCHI PHÍ HIỆU NĂNG:§r thấp
        option.CaveFogFallOff.comment = Chỉnh tốc độ dải sương mù đạt đến phần sáng nhất.

screen.Clouds.comment = Các cài đặt liên quan đến mây thể tích (raymarch).
    option.VOLUMETRIC_CLOUDS.comment = Bật/tắt mây. §aCHI PHÍ HIỆU NĂNG:§r trung bình đến cao
    option.CLOUDS_QUALITY.comment = Chỉnh độ phân giải của mây thể tích. §aCHI PHÍ HIỆU NĂNG:§r cao
    option.CLOUDS_SHADOWS.comment = Bật/tắt bóng của mây đổ xuống mặt đất và sương mù bên dưới chúng. §aCHI PHÍ HIỆU NĂNG:§r thấp đến trung bình
    option.Daily_Weather.comment = Bật/tắt thời tiết thay đổi mỗi ngày. §bĐây là gì?§r Có 10 mẫu thời tiết mà shader luân phiên mỗi ngày. Bạn không thể chỉnh độ phủ mây khi bật mục này. §aCHI PHÍ HIỆU NĂNG:§r thấp
    option.CHOOSE_RANDOM_WEATHER_PROFILE.comment = §bĐây là gì?§r Cho shader chọn ngẫu nhiên thời tiết từ một trong các ngày bên dưới. Khi tắt, shader sẽ chọn lần lượt theo thứ tự các ngày.
    option.Cloud_Speed.comment = Chỉnh tốc độ mây trôi theo thời gian trong ngày.
    option.Rain_coverage.comment = Chỉnh mức độ mây phủ bầu trời khi trời mưa.

screen.World.comment = Các cài đặt cho môi trường và thế giới: mây, sương mù, khí hậu, bầu trời và cây lay động.
    screen.Water.comment = Các cài đặt liên quan đến nước.
        option.WATER_REFLECTIONS.comment = Bật/tắt mọi phản chiếu cho vật trong suốt. Mục này cho phép bật các cài đặt bên dưới. §aCHI PHÍ HIỆU NĂNG:§r thấp đến cao
        option.SCREENSPACE_REFLECTIONS.comment = Bật/tắt phản chiếu không gian màn hình trên vật trong suốt. §aCHI PHÍ HIỆU NĂNG:§r trung bình
        option.SSR_STEPS.comment = Chỉnh chất lượng phản chiếu không gian màn hình trên vật trong suốt. §aCHI PHÍ HIỆU NĂNG:§r trung bình đến cao
        option.WATER_SUN_SPECULAR.comment = Bật/tắt phản chiếu Mặt Trời và Mặt Trăng trên vật trong suốt. §aCHI PHÍ HIỆU NĂNG:§r thấp
        option.WATER_BACKGROUND_SPECULAR.comment = Bật/tắt phản chiếu bầu trời và sương mù trên vật trong suốt. §aCHI PHÍ HIỆU NĂNG:§r thấp đến trung bình
        option.Refraction.comment = Bật/tắt khúc xạ trên vật trong suốt. §bĐây là gì?§r Khi nhìn vào nước, bạn thấy ánh sáng bị khúc xạ làm méo những gì ở bên trong. §aCHI PHÍ HIỆU NĂNG:§r thấp
        option.Dirt_Amount.comment = Chỉnh lượng cặn bẩn trong nước. Giá trị này quyết định độ đục (sương mù) bên trong nước; thấp hơn = nước trong hơn.
        option.Water_Top_Layer.comment = Chỉnh tọa độ Y của mặt biển trong thế giới.
        
        screen.Water_fog_color.comment = Chỉnh màu sương mù trong nước.

screen.Climate.comment = Các cài đặt liên quan đến khí hậu, như màu theo mùa, thời tiết theo ngày và sương mù riêng của từng quần xã.
    screen.Seasons.comment = Màu sắc thay đổi lần lượt theo mùa hè, thu, đông và xuân.
        option.Seasons.comment = Màu sắc thay đổi lần lượt theo mùa hè, thu, đông và xuân. §aCHI PHÍ HIỆU NĂNG:§r thấp
        option.Season_Length.comment = Chỉnh độ dài của một mùa, tính bằng ngày trong Minecraft.
        option.Snowy_Winter.comment = Bật/tắt tuyết vào mùa đông. §aCHI PHÍ HIỆU NĂNG:§r thấp
        screen.Summer_colors.comment = Chỉnh màu thực vật vào mùa hè.
        screen.Fall_colors.comment = Chỉnh màu thực vật vào mùa thu.
        screen.Winter_colors.comment = Chỉnh màu thực vật vào mùa đông.
        screen.Spring_colors.comment = Chỉnh màu thực vật vào mùa xuân.
    
    option.PER_BIOME_ENVIRONMENT.comment = Bật/tắt mọi môi trường đặc biệt chỉ xuất hiện ở một số quần xã. §aCHI PHÍ HIỆU NĂNG:§r thấp

        screen.SWAMP.comment = Chỉnh môi trường của loại quần xã này.
            option.SWAMP_ENV.comment = Chỉ bật/tắt môi trường cho loại quần xã này. Môi trường của các quần xã khác vẫn hoạt động dù mục này bị tắt.

        screen.JUNGLE.comment = Chỉnh môi trường của loại quần xã này.
            option.JUNGLE_ENV.comment = Chỉ bật/tắt môi trường cho loại quần xã này. Môi trường của các quần xã khác vẫn hoạt động dù mục này bị tắt.

        screen.DARKFOREST.comment = Chỉnh môi trường của loại quần xã này.
            option.DARKFOREST_ENV.comment = Chỉ bật/tắt môi trường cho loại quần xã này. Môi trường của các quần xã khác vẫn hoạt động dù mục này bị tắt.


screen.Waving_Stuff.comment = Các cài đặt liên quan đến những thứ lay động.
    option.WAVY_PLANTS.comment = Bật/tắt cây cối lay động. §aCHI PHÍ HIỆU NĂNG:§r rất thấp
    option.WAVY_STRENGTH.comment = Chỉnh mức độ cây lay động.
    option.WAVY_SPEED.comment = Chỉnh tốc độ cây lay động.

screen.Post_Processing.comment = Các cài đặt cho mọi hiệu ứng hậu kỳ, từ khử răng cưa đến ánh xạ tông màu.
    screen.Tonemapping.comment = Các cài đặt liên quan đến màu sắc và ánh xạ tông màu.
    screen.Exposure.comment = Các cài đặt liên quan đến độ phơi sáng.
    screen.DepthOfField.comment = Các cài đặt liên quan đến độ sâu trường ảnh.
    screen.Purkinje_effect.comment = Các cài đặt liên quan đến hiệu ứng Purkinje.
    option.SHARPENING.comment = Chỉnh mức làm nét thích ứng theo độ tương phản áp dụng lên ảnh. Có thể lấy lại nhiều chi tiết bị mất do khử răng cưa hoặc nâng độ phân giải.
    option.BLOOM_STRENGTH.comment = Chỉnh lượng bloom áp dụng lên ảnh. §bĐây là gì?§r Bloom là quầng sáng mềm quanh mọi thứ, cho thấy vật đó sáng hay không.
    screen.TAA_OPTIONS.comment = Các cài đặt liên quan đến khử răng cưa.
        option.SCREENSHOT_MODE.comment = Bật/tắt tích lũy khung hình để có ảnh ít nhiễu và chất lượng cao. §bĐây là gì?§r Nó chồng các khung hình đã qua lên khung hình mới tạo ra, giống như ảnh phơi sáng dài.
        option.TAA.comment = Bật/tắt khử răng cưa theo thời gian. Xóa mọi cạnh răng cưa, làm ảnh mềm hơn và giúp giảm nhiễu cho nhiều hiệu ứng. Sẽ gây bóng mờ hoặc vệt đuôi vì dùng các khung hình cũ để lấy thêm thông tin. §aCHI PHÍ HIỆU NĂNG:§r thấp
        option.BLEND_FACTOR.comment = Chỉnh mức dùng lịch sử khung hình. Giá trị cao nghĩa là ít dựa vào lịch sử nên có thể nhấp nháy và nhiễu. Giá trị thấp dựa nhiều vào lịch sử nên ít nhiễu hơn nhưng bị nhòe và có nhiều vệt đuôi hơn.
        option.TAA_UPSCALING.comment = Bật/tắt nâng độ phân giải theo thời gian. Giữ được khá nhiều chất lượng từ ảnh có độ phân giải thấp khi nâng lên, nên bạn vẫn có hình ảnh sắc nét hơn so với nâng thông thường mà hiệu năng vẫn tốt hơn.
        option.SCALE_FACTOR.comment = Chỉnh phần độ phân giải của bạn dùng để nâng lên. Dưới 0.5 hoàn toàn không khuyến khích, mục này chỉ để cho vui :P
	screen.COLOR_GRADING.comment = Các tùy chọn chỉnh màu nâng cao.
		option.LUMINANCE_CURVE.comment = Bật đường cong tông màu. Độc lập với chỉnh màu và được áp dụng trước.
		option.COLOR_GRADING_ENABLED.comment = Bật chỉnh màu. Các thanh trượt RGB sẽ không ảnh hưởng đến độ sáng. Được áp dụng sau đường cong tông màu.

option.RESOURCEPACK_SKY.comment = Bật/tắt hỗ trợ bầu trời của gói tài nguyên. Chọn dùng toàn bộ bầu trời của gói hoặc giữ Mặt Trời và Mặt Trăng của shader. §aCHI PHÍ HIỆU NĂNG:§r rất thấp
option.SKY_GROUND = Mặt đất khí quyển

option.MATERIAL_AO.comment = Bật/tắt dùng AO dựa trên dữ liệu gói tài nguyên cung cấp. §aCHI PHÍ HIỆU NĂNG:§r rất thấp
option.WATER_WAVE_STRENGTH.comment = Chỉnh mức độ sóng nước hiện rõ.
option.MOONPHASE_BASED_MOONLIGHT.comment = §bĐây là gì?§r Mỗi đêm Mặt Trăng có độ sáng khác nhau. Cài đặt này chỉnh độ sáng ánh trăng theo phần Mặt Trăng đang sáng. §aCHI PHÍ HIỆU NĂNG:§r gần như không đáng kể

option.END_STORM_DENSTIY.comment = §bĐây là gì?§r Đây là lớp sương mù mây tối ở End. Chỉnh mật độ bão End.
option.NETHER_PLUME_DENSITY.comment = §bĐây là gì?§r Đây là những cột khói dày phát sáng ở Nether. Chỉnh mật độ khói Nether.

option.CloudLayer0.comment = Bật/tắt tầng mây nhỏ. §aCHI PHÍ HIỆU NĂNG:§r trung bình
option.CloudLayer0_coverage.comment = Chỉnh độ phủ của những đám mây này trên bầu trời.
option.CloudLayer0_density.comment = Chỉnh độ đặc (dày) của những đám mây này.
option.CloudLayer0_height.comment = Chỉnh độ cao mà những đám mây này bay.

option.CloudLayer1.comment = Bật/tắt tầng mây lớn. §aCHI PHÍ HIỆU NĂNG:§r trung bình
option.CloudLayer1_coverage.comment = Chỉnh độ phủ của những đám mây này trên bầu trời.
option.CloudLayer1_density.comment = Chỉnh độ đặc (dày) của những đám mây này.
option.CloudLayer1_height.comment = Chỉnh độ cao mà những đám mây này bay. §cKHÔNG ĐƯỢC THẤP HƠN MÂY NHỎ§r

option.CloudLayer2.comment = Bật/tắt tầng mây rất cao và mỏng. §aCHI PHÍ HIỆU NĂNG:§r thấp
option.CloudLayer2_coverage.comment = Chỉnh độ phủ của những đám mây này trên bầu trời.
option.CloudLayer2_density.comment = Chỉnh độ đặc (dày) của những đám mây này.
option.CloudLayer2_height.comment = Chỉnh độ cao mà những đám mây này bay. §cKHÔNG ĐƯỢC THẤP HƠN MÂY LỚN§r

option.SKY_GROUND.comment = §bĐây là gì?§r Đây là nửa dưới tối của bầu trời, lẽ ra là mặt đất nếu Minecraft có tầm nhìn vô hạn. §aCHI PHÍ HIỆU NĂNG:§r rất rất thấp. §cTắt mục này lại chậm hơn đôi chút so với bật vì cần tính toán thêm.§r
option.SNELLS_WINDOW.comment = §bĐây là gì?§r Đây là vòng tròn tối phản chiếu bạn thấy khi ở dưới nước. Nó mô phỏng hiện tượng ngoài đời gọi là "phản xạ toàn phần". §aCHI PHÍ HIỆU NĂNG:§r cực kỳ nhỏ.
option.entityShadowDistanceMul.comment = §bĐây là gì?§r Chỉnh khoảng cách bóng đổ hoạt động cho thực thể. Hữu ích nếu bạn muốn giữ bóng thực thể và tăng hiệu năng ở nơi có nhiều thực thể.

